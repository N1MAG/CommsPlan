{
  "name": "commsplan-documentation",
  "private": true,
  "version": "0.1.0",
  "description": "The version-controlled CommsPlan documentation site.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vitepress .",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "verify:artifact": "node scripts/verify-build.mjs",
    "verify": "npm audit --audit-level=moderate && npm run build && npm run verify:artifact"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "7.3.7",
    "@vitejs/plugin-vue": "6.0.10"
  }
}
